{
  "$schema":"https://getcomposer.org/schema.json",
  "name":"azhura/platform",
  "type":"project",
  "description":"A modular platform for orchestrating workspaces, workflows, knowledge and integrations.",
  "keywords":["azhura","platform","laravel","workflow","workspace"],
  "license":"MIT",
  "require":{"php":"^8.3","laravel/framework":"^13.0","laravel/tinker":"^3.0"},
  "require-dev":{"larastan/larastan":"^3.0","laravel/pint":"^1.24","mockery/mockery":"^1.6","nunomaduro/collision":"^8.6","phpunit/phpunit":"^12.0"},
  "autoload":{"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev":{"psr-4":{"Tests\\":"tests/"}},
  "scripts":{
    "setup":["composer install","@php -r \"file_exists('.env') || copy('.env.example', '.env');\"","@php artisan key:generate","@php artisan migrate --force"],
    "test":"@php artisan test",
    "analyse":"phpstan analyse --memory-limit=1G",
    "format":"pint",
    "format:check":"pint --test",
    "post-autoload-dump":["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"],
    "post-update-cmd":["@php artisan vendor:publish --tag=laravel-assets --ansi --force"],
    "post-root-package-install":["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
    "post-create-project-cmd":["@php artisan key:generate"]
  },
  "config":{"optimize-autoloader":true,"preferred-install":"dist","sort-packages":true,"allow-plugins":{"php-http/discovery":true}},
  "minimum-stability":"stable","prefer-stable":true
}
